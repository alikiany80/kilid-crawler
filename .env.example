# All variables are optional; CLI flags override where both exist.

# SQLite file for the sqlite sink and the crawl state (seen table). Default: data/kilid.sqlite
KILID_DB_PATH=data/kilid.sqlite

# Politeness: minimum delay between requests to kilid.com (ms)
KILID_DELAY_MS=350

# HTTP client
HTTP_TIMEOUT_MS=20000
HTTP_MAX_RETRIES=4
HTTP_RATE_LIMIT_BACKOFF_MS=15000

# Only required with --output=http
SINK_URL=
SINK_TOKEN=

# debug | info | warn | error (logs go to stderr as JSON lines)
LOG_LEVEL=info

# Max listings per HTTP sink POST (1..100)
SINK_BATCH_SIZE=25
